<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Donasi - Kelompok 5</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="/js/tailwind-config.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased overflow-x-hidden">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        primary: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 700: '#15803d' }
                    }
                }
            }
        }
    </script>
    <div class="flex h-screen overflow-hidden">
        <%- include("partials/dashboard-sidebar", { activePage }) %>

        <div class="flex-1 flex flex-col h-screen overflow-hidden">
            <%- include("partials/dashboard-header") %>

            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">Riwayat Donasi</h1>
                        <p class="text-sm text-slate-500 mt-1">Lihat semua donasi yang pernah Anda lakukan.</p>
                    </div>
                    <a href="/dashboard" class="mt-4 sm:mt-0 text-sm font-semibold text-primary-600 hover:text-primary-700 flex items-center">
                        Kembali ke Dashboard <i class="ph ph-arrow-right ml-1"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-500 mb-1">Total Donasi</p>
                                <h3 class="text-3xl font-bold text-slate-900" id="donation-total">Rp 0</h3>
                            </div>
                            <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">
                                <i class="ph ph-wallet text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-500 mb-1">Jumlah Transaksi</p>
                                <h3 class="text-3xl font-bold text-slate-900" id="donation-count">0</h3>
                            </div>
                            <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                                <i class="ph ph-receipt text-2xl"></i>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-sm font-medium text-slate-500 mb-1">Campaign Didukung</p>
                                <h3 class="text-3xl font-bold text-slate-900" id="donation-campaigns">0</h3>
                            </div>
                            <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center text-amber-600">
                                <i class="ph ph-heart text-2xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-5">
                        <h2 class="text-lg font-bold text-slate-900">Daftar Donasi</h2>
                        <div class="text-sm text-slate-500 flex items-center space-x-2">
                            <i class="ph ph-clock"></i>
                            <span>Urut dari yang terbaru</span>
                        </div>
                    </div>

                    <div class="space-y-4" id="donationHistoryList">
                        <div class="text-center py-10 bg-slate-50 rounded-2xl border border-slate-100">
                            <div class="animate-spin rounded-full h-8 w-8 border-4 border-primary-500 border-t-transparent mx-auto mb-3"></div>
                            <p class="text-slate-500 font-medium">Memuat riwayat donasi...</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/app.js" defer></script>
</body>
</html>
