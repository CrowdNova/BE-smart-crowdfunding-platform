<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buat Campaign Baru - Kelompok 5</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="/js/tailwind-config.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased overflow-x-hidden">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        primary: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 700: '#15803d' }
                    }
                }
            }
        }
    </script>
    <div class="flex h-screen overflow-hidden">
        <%- include("partials/dashboard-sidebar", { activePage }) %>

        <div class="flex-1 flex flex-col h-screen overflow-hidden">
            <%- include("partials/dashboard-header") %>

            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50/50">
                <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">
                    <div class="mb-8 border-b border-slate-100 pb-5">
                        <h3 class="text-xl font-bold text-slate-900">Informasi Campaign</h3>
                        <p class="text-sm text-slate-500 mt-1">Lengkapi form di bawah ini untuk mempublikasikan galang dana Anda.</p>
                    </div>

                    <form action="#" class="space-y-6" id="campaignForm">
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Judul Campaign <span class="text-red-500">*</span></label>
                            <input type="text" name="title" required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 focus:border-primary-500 text-sm outline-none" placeholder="Cth: Bantu Biaya Sekolah Anak Yatim">
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-2">Target Dana (Rp) <span class="text-red-500">*</span></label>
                                <input type="number" name="targetAmount" required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 outline-none" placeholder="10000000">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-2">Batas Waktu (Deadline) <span class="text-red-500">*</span></label>
                                <input type="date" name="deadline" required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 outline-none text-slate-600">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Kategori <span class="text-red-500">*</span></label>
                            <select name="category" required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 outline-none text-slate-600 bg-white">
                                <option value="">Pilih Kategori...</option>
                                <option>Bantuan Medis</option>
                                <option>Pendidikan</option>
                                <option>Infrastruktur & Pembangunan</option>
                                <option>Sosial & Kemanusiaan</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Foto / Banner Campaign</label>
                            <label for="campaignImageFile" class="mt-1 flex flex-col sm:flex-row items-center gap-4 px-6 py-5 border-2 border-slate-300 border-dashed rounded-xl hover:bg-slate-50 transition-colors cursor-pointer">
                                <img id="campaignImagePreview" src="" alt="Preview gambar campaign" class="hidden w-full sm:w-40 h-28 rounded-xl object-cover border border-slate-200 bg-slate-100">
                                <div class="space-y-1 text-center sm:text-left flex-1">
                                    <i class="ph ph-image text-4xl text-slate-400"></i>
                                    <div class="text-sm text-slate-600">
                                        <span class="font-semibold text-primary-600 hover:text-primary-500">Upload gambar campaign</span>
                                    </div>
                                    <p id="campaignImageFileName" class="text-xs text-slate-500">PNG atau JPG maksimal 5MB</p>
                                </div>
                                <input id="campaignImageFile" type="file" name="imageFile" accept="image/*" class="sr-only">
                            </label>
                            <input type="url" name="imageUrl" class="mt-3 w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 outline-none text-sm" placeholder="Link gambar (opsional)">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-2">Cerita / Deskripsi Lengkap <span class="text-red-500">*</span></label>
                            <textarea rows="6" name="story" required class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-primary-500 outline-none text-sm" placeholder="Ceritakan secara detail mengapa Anda menggalang dana ini..."></textarea>
                        </div>

                        <div class="flex flex-col sm:flex-row sm:justify-end gap-3 pt-2">
                            <a href="/dashboard" class="px-5 py-2.5 rounded-lg border border-slate-200 text-slate-600 font-medium text-sm text-center hover:bg-slate-50">Batal</a>
                            <button type="submit" class="px-5 py-2.5 rounded-lg bg-primary-600 text-white font-semibold text-sm hover:bg-primary-700">Publikasikan</button>
                        </div>
                    </form>
                </div>
            </main>
        </div>
    </div>

    <script src="/js/app.js" defer></script>
</body>
</html>
