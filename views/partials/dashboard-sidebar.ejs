<% const userName = currentUser && currentUser.name ? currentUser.name : "Pengguna"; %>
<% const initials = userName.trim().split(/\s+/).slice(0, 2).map((part) => part[0]?.toUpperCase() || "").join("") || "U"; %>
<% const isActive = (page) => activePage === page; %>
<aside class="w-64 bg-white border-r border-slate-200 hidden md:flex flex-col flex-shrink-0 z-10 shadow-sm">
    <div class="h-16 flex items-center px-6 border-b border-slate-200">
        <i class="ph-fill ph-hand-heart text-primary-600 text-3xl mr-2"></i>
        <span class="text-xl font-bold text-slate-800 tracking-tight">CrowdFund</span>
    </div>

    <div class="p-4 flex-1 overflow-y-auto">
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4 px-2">Menu Utama</p>
        <nav class="space-y-1">
            <a href="/dashboard" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('dashboard') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                <i class="ph ph-squares-four text-xl mr-3"></i> Dashboard
            </a>
            <a href="/buat-campaign" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('buat-campaign') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                <i class="ph ph-plus-circle text-xl mr-3"></i> Buat Campaign
            </a>
            <a href="/campaign-saya" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('campaign-saya') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                <i class="ph ph-megaphone text-xl mr-3"></i> Campaign Saya
            </a>
            <a href="/riwayat-donasi" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('riwayat-donasi') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                <i class="ph ph-wallet text-xl mr-3"></i> Riwayat Donasi
            </a>
        </nav>

        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mt-8 mb-4 px-2">Pengaturan</p>
        <nav class="space-y-1">
            <a href="/pengaturan-sistem" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('pengaturan-sistem') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                <i class="ph ph-gear text-xl mr-3"></i> Pengaturan Sistem
            </a>
            <% if (currentUser && currentUser.role === 'admin') { %>
                <a href="/admin" class="flex items-center px-3 py-2.5 rounded-lg font-medium transition-colors <%= isActive('admin') ? 'bg-primary-50 text-primary-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                    <i class="ph ph-shield-check text-xl mr-3"></i> Admin Dashboard
                </a>
            <% } %>
        </nav>
    </div>

    <div class="p-4 border-t border-slate-200">
        <div class="flex items-center w-full p-2 rounded-lg">
            <div class="w-9 h-9 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-sm mr-3">
                <span><%= initials %></span>
            </div>
            <div class="flex-1 text-left">
                <p class="text-sm font-semibold text-slate-900">Profil Saya</p>
                <p class="text-xs text-slate-500"><%= userName %></p>
            </div>
        </div>
        <a href="/logout" class="mt-2 block text-xs font-semibold text-slate-500 hover:text-primary-600">Logout</a>
    </div>
</aside>
